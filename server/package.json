{
  "name": "eclipse-order-local-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows-only loopback bootstrap for the Eclipse Order self-hosted API",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "setup:domina": "node --env-file=.env src/bootstrap-admin.js",
    "check:login": "node --env-file=.env src/check-login.js",
    "account:set-password": "node --env-file=.env src/set-local-password.js",
    "setup:local": "node --env-file=.env src/setup-local.js",
    "discord:account": "node --env-file=.env src/manage-discord-account.js",
    "discord:check": "node --env-file=.env src/check-discord-membership.js",
    "discord:config": "node --env-file=.env src/check-discord-config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mysql2": "^3.15.0",
    "discord.js": "^14.22.1"
  }
}
