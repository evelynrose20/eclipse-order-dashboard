# Copy this file as server/.env and keep it ONLY on your Windows PC.
API_PORT=3182
DB_NAME=eclipse_order
DB_PORT=3306
DB_USER=eclipse_api
DB_PASSWORD=

# The exact FRONTEND origin (scheme + hostname, no trailing slash or path).
# Local test: http://localhost:5173
# Live Imperium Noctis portal: https://rosefires.com
# IMPORTANT: use the precise scheme + host shown in the address bar, without a slash.
API_ALLOWED_ORIGIN=https://rosefires.com

# When public mode is enabled, loopback requests still need a separate local origin.
# The local origin is accepted ONLY on localhost/127.0.0.1 API requests, not through the public hostname.
API_LOCAL_ORIGIN=http://localhost:5173

# Set true ONLY after Cloudflare route, account/session security, backups, and CORS are verified.
API_PUBLIC_ENABLED=false
API_PUBLIC_HOST=api.rosefires.com

# Only needed if HeidiSQL administrator account is not named root.
MIGRATION_DB_USER=root

# Discord OAuth2: create a Discord Developer application and configure its OAuth2 redirect.
# The client ID is public; the CLIENT SECRET must NEVER be committed to GitHub or Vite.
# Requires a public HTTPS API callback URL matching your Discord Developer Portal redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.rosefires.com/auth/discord/callback
# Exact landing page on the custom domain after successful Discord authorization.
# Must use the same origin as API_ALLOWED_ORIGIN.
DISCORD_FRONTEND_URL=https://rosefires.com/

# Mandatory for Discord-only member access. Both IDs come from Discord Developer Mode.
DISCORD_GUILD_ID=
# Bot token from the same Discord application; it must already be in your server.
# Keep this private. Bot needs permission to read guild members and create invites for guilds.join.
DISCORD_BOT_TOKEN=
# Optional public Discord invite if you prefer an ordinary manual invitation as fallback.
DISCORD_INVITE_URL=

# Destination channel for the free Discord scheduled-event announcement bot.
DISCORD_EVENT_ANNOUNCEMENT_CHANNEL_ID=
