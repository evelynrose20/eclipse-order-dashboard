# Copy this file as server/.env and keep it ONLY on your Windows PC.
API_PORT=3182
DB_NAME=eclipse_order
DB_PORT=3306
DB_USER=eclipse_api
DB_PASSWORD=

# The exact FRONTEND origin (scheme + hostname, no trailing slash or path).
# Local test: http://localhost:5173
# GitHub Pages example: https://evelynrose20.github.io
# IMPORTANT: use the origin shown in your actual published website address bar.
API_ALLOWED_ORIGIN=http://localhost:5173

# When public mode is enabled, loopback requests still need a separate local origin.
# The local origin is accepted ONLY on localhost/127.0.0.1 API requests, not through the public hostname.
API_LOCAL_ORIGIN=http://localhost:5173

# Set true ONLY after Cloudflare route, account/session security, backups, and CORS are verified.
API_PUBLIC_ENABLED=false
API_PUBLIC_HOST=api.rosefires.com

# Only needed if HeidiSQL administrator account is not named root.
MIGRATION_DB_USER=root
